rules_version = '2';

// Costflow 팀 데이터 보안 규칙
// 이메일 인증이 끝난 @spextrum.net Google 계정만 읽고 쓸 수 있습니다.
service cloud.firestore {
  match /databases/{database}/documents {

    function isTeam() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@spextrum[.]net$');
    }

    match /projects/{projectId} {
      allow read, write: if isTeam();

      match /items/{itemId} {
        allow read, write: if isTeam();
      }
    }

    // 사이드바가 모든 프로젝트의 품목을 한 번에 불러올 때 사용하는 조회
    match /{path=**}/items/{itemId} {
      allow read: if isTeam();
    }
  }
}
